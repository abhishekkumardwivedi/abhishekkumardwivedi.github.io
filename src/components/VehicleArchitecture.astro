---
const nodes = [
  { id: 'autonomy', title: 'Autonomy Compute', sub: 'Perception • Prediction • Planning', cls: 'ai' },
  { id: 'motion', title: 'Motion Domain', sub: 'Dual-redundant safety-oriented control', cls: 'core' },
  { id: 'steer', title: 'Steering-by-Wire', sub: 'Lateral actuation + feedback', cls: 'act' },
  { id: 'brake', title: 'Brake-by-Wire', sub: 'E/H + regenerative blend', cls: 'act' },
  { id: 'drive', title: '4-Wheel Propulsion', sub: '4 inverters • motors • resolvers', cls: 'act' },
  { id: 'power', title: 'HV / LV Power', sub: 'Battery • BMS • 12V / 48V', cls: 'power' },
  { id: 'network', title: 'Vehicle Network', sub: 'Ethernet • CAN-FD • Gateway', cls: 'net' },
];
---

<div class="va" data-architecture>
  <div class="va-head">
    <div><span class="eyebrow">LIVE VEHICLE MODEL</span><h3>Drive-by-Wire Execution Platform</h3><p>Watch motion intent travel through the execution layer into vehicle actuation.</p></div>
    <div class="controls"><button type="button" class="mode active" data-mode="flow">Signal Flow</button><button type="button" class="mode" data-mode="fault">Fault Mode</button><button type="button" class="reset" data-reset>Reset</button></div>
  </div>

  <div class="canvas" role="application" aria-label="Interactive animated Drive-by-Wire architecture">
    <div class="grid-glow"></div>
    <div class="flow-label l1">MOTION INTENT</div><div class="flow-label l2">VALIDATED CONTROL</div><div class="flow-label l3">ACTUATION</div>

    <div class="architecture-stack">
      <div class="architecture-row single">
        <button type="button" class="node ai" data-node="autonomy"><span class="node-top"><span class="dot"></span><span class="tag">AI / ADAS</span></span><strong>Autonomy Compute</strong><small>Perception • Prediction • Planning</small></button>
      </div>
      <div class="connector vertical"><span></span></div>
      <div class="architecture-row single">
        <button type="button" class="node core" data-node="motion"><span class="node-top"><span class="dot"></span><span class="tag">EXECUTION</span></span><strong>Motion Domain</strong><small>Dual-redundant safety-oriented control</small></button>
      </div>
      <div class="connector vertical"><span></span></div>
      <div class="architecture-row triple">
        <button type="button" class="node act" data-node="steer"><span class="node-top"><span class="dot"></span><span class="tag">ACTUATION</span></span><strong>Steering-by-Wire</strong><small>Lateral actuation + feedback</small></button>
        <button type="button" class="node act" data-node="brake"><span class="node-top"><span class="dot"></span><span class="tag">ACTUATION</span></span><strong>Brake-by-Wire</strong><small>E/H + regenerative blend</small></button>
        <button type="button" class="node act" data-node="drive"><span class="node-top"><span class="dot"></span><span class="tag">ACTUATION</span></span><strong>4-Wheel Propulsion</strong><small>4 inverters • motors • resolvers</small></button>
      </div>
      <div class="connector branch"><span></span></div>
      <div class="architecture-row bottom">
        <button type="button" class="node power" data-node="power"><span class="node-top"><span class="dot"></span><span class="tag">POWER</span></span><strong>HV / LV Power</strong><small>Battery • BMS • 12V / 48V</small></button>
        <button type="button" class="node net" data-node="network"><span class="node-top"><span class="dot"></span><span class="tag">NETWORK</span></span><strong>Vehicle Network</strong><small>Ethernet • CAN-FD • Gateway</small></button>
      </div>
    </div>
  </div>

  <div class="statusbar"><span class="live-dot"></span><strong data-status>LIVE SIGNAL PATH</strong><span class="status-copy" data-status-copy>Autonomy → Motion Domain → vehicle actuation</span></div>
  <aside class="inspector" data-inspector aria-live="polite"><div class="inspector-empty">Click a subsystem to inspect it. Try <strong>Fault Mode</strong> to see degraded operation.</div></aside>

  <script is:inline>
    const root = document.querySelector('[data-architecture]');
    if (root) {
      const info = {
        autonomy: ['Autonomy Compute', 'Produces high-level motion intent from perception, prediction and planning. It remains separated from direct safety-critical actuator control.', ['Motion Domain']],
        motion: ['Motion Domain', 'Deterministic execution layer for command validation, arbitration, real-time control and fault handling.', ['Autonomy Compute','Steering-by-Wire','Brake-by-Wire','4-Wheel Propulsion','HV / LV Power','Vehicle Network']],
        steer: ['Steering-by-Wire', 'Safety-critical lateral actuation with redundant sensing, actuator monitoring and defined degraded modes.', ['Motion Domain']],
        brake: ['Brake-by-Wire', 'Coordinates electro-hydraulic friction braking and regenerative braking while respecting wheel, battery and thermal constraints.', ['Motion Domain']],
        drive: ['4-Wheel Propulsion', 'Four independently controlled inverter/motor paths with rotor-position feedback for precise torque execution.', ['Motion Domain']],
        power: ['HV / LV Power', 'HV battery and BMS provide propulsion energy while independent low-voltage paths support vehicle control and redundancy.', ['Motion Domain']],
        network: ['Vehicle Network', 'Automotive Ethernet and CAN-FD provide communication paths with gateway/zonal isolation.', ['Motion Domain']],
      };
      const nodes=[...root.querySelectorAll('[data-node]')], panel=root.querySelector('[data-inspector]'), status=root.querySelector('[data-status]'), statusCopy=root.querySelector('[data-status-copy]'), modes=[...root.querySelectorAll('[data-mode]')];
      function select(id){const item=info[id];nodes.forEach(n=>{n.classList.toggle('selected',n.dataset.node===id);n.classList.toggle('dim',n.dataset.node!==id);});panel.innerHTML=`<div class="selected-title"><span class="status"></span><strong>${item[0]}</strong></div><p>${item[1]}</p><div class="connect-title">CONNECTED TO</div><div class="chips">${item[2].map(x=>`<span>${x}</span>`).join('')}</div>`;}
      nodes.forEach(n=>n.addEventListener('click',()=>select(n.dataset.node)));
      modes.forEach(m=>m.addEventListener('click',()=>{modes.forEach(x=>x.classList.remove('active'));m.classList.add('active');root.classList.toggle('fault-mode',m.dataset.mode==='fault');if(m.dataset.mode==='fault'){status.textContent='FAULT INJECTION: MOTION PATH A OFFLINE';statusCopy.textContent='Redundant path active • vehicle remains controllable';panel.innerHTML='<div class="selected-title"><span class="fault-dot"></span><strong>Degraded Operation</strong></div><p>One motion-control path is unavailable. The redundant execution path remains active and the system transitions to a reduced-capability state.</p><div class="chips"><span>Fault detected</span><span>Redundant path active</span><span>Reduced redundancy</span></div> ';}else{status.textContent='LIVE SIGNAL PATH';statusCopy.textContent='Autonomy → Motion Domain → vehicle actuation';panel.innerHTML='<div class="inspector-empty">Click a subsystem to inspect it. Try <strong>Fault Mode</strong> to see degraded operation.</div>';nodes.forEach(n=>n.classList.remove('selected','dim'));}}));
      root.querySelector('[data-reset]').addEventListener('click',()=>modes[0].click());
    }
  </script>
</div>

<style>
.va{--accent:#10b981;--blue:#3b82f6;--purple:#8b5cf6;--amber:#f59e0b;border:1px solid var(--sl-color-gray-5);border-radius:18px;overflow:hidden;margin:2rem 0;background:var(--sl-color-bg);box-shadow:0 14px 40px color-mix(in srgb,var(--sl-color-black) 10%,transparent)}
.va-head{padding:1.2rem 1.35rem;display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid var(--sl-color-gray-5)}.eyebrow{font-size:.62rem;letter-spacing:.14em;font-weight:800;opacity:.6}.va h3{margin:.25rem 0;font-size:1.2rem}.va-head p{margin:0;font-size:.82rem;opacity:.7}.controls{display:flex;gap:.35rem;flex-wrap:wrap}.mode,.reset{font:inherit;font-size:.68rem;padding:.42rem .6rem;border:1px solid var(--sl-color-gray-5);background:transparent;color:inherit;border-radius:7px;cursor:pointer}.mode.active{background:var(--sl-color-gray-6);font-weight:700}
.canvas{position:relative;min-height:610px;padding:44px 28px 34px;overflow:hidden;background:radial-gradient(circle at 50% 15%,color-mix(in srgb,var(--accent) 7%,transparent),transparent 42%)}.grid-glow{position:absolute;inset:0;opacity:.16;background-image:linear-gradient(var(--sl-color-gray-5) 1px,transparent 1px),linear-gradient(90deg,var(--sl-color-gray-5) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 92%)}
.architecture-stack{position:relative;z-index:3;max-width:820px;margin:auto;display:flex;flex-direction:column;align-items:center}.architecture-row{width:100%;display:flex;justify-content:center;gap:24px}.architecture-row.single .node{width:min(360px,100%)}.architecture-row.triple .node{flex:1;max-width:250px}.architecture-row.bottom{justify-content:space-between;max-width:560px}.architecture-row.bottom .node{width:250px}.node{min-height:92px;text-align:left;border:1px solid var(--sl-color-gray-5);border-radius:13px;padding:12px 14px;background:color-mix(in srgb,var(--sl-color-bg) 94%,transparent);backdrop-filter:blur(8px);color:inherit;cursor:pointer;transition:transform .25s,opacity .3s,box-shadow .25s,border-color .25s}.node.ai{border-color:color-mix(in srgb,var(--blue) 50%,var(--sl-color-gray-5))}.node.core{border:2px solid color-mix(in srgb,var(--accent) 65%,var(--sl-color-gray-5));box-shadow:0 0 28px color-mix(in srgb,var(--accent) 13%,transparent)}.node.act{border-color:color-mix(in srgb,var(--purple) 40%,var(--sl-color-gray-5))}.node.power{border-color:color-mix(in srgb,var(--amber) 45%,var(--sl-color-gray-5))}.node.net{border-color:color-mix(in srgb,#06b6d4 45%,var(--sl-color-gray-5))}.node:hover,.node.selected{transform:translateY(-3px);box-shadow:0 10px 28px color-mix(in srgb,var(--sl-color-black) 14%,transparent)}.node.selected{outline:2px solid color-mix(in srgb,var(--accent) 60%,transparent);outline-offset:2px}.node.dim{opacity:.2}.node-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.dot,.live-dot,.status,.fault-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 12%,transparent)}.tag{font-size:.53rem;letter-spacing:.08em;opacity:.45}.node strong,.node small{display:block}.node strong{font-size:.87rem}.node small{font-size:.68rem;opacity:.62;margin-top:4px;line-height:1.3}
.connector{position:relative;width:100%;height:42px;display:flex;justify-content:center}.connector.vertical span{height:100%;width:2px;background:var(--accent);opacity:.45;position:relative}.connector.vertical span:after{content:"";position:absolute;width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent);left:-2.5px;animation:flowDown 1.3s linear infinite}.connector.branch{height:44px}.connector.branch:before{content:"";position:absolute;top:0;left:16.7%;right:16.7%;height:2px;background:var(--accent);opacity:.4}.connector.branch:after{content:"";position:absolute;top:0;left:50%;width:2px;height:44px;background:var(--accent);opacity:.4}.connector.branch span:before,.connector.branch span:after{content:"";position:absolute;top:0;width:2px;height:44px;background:var(--accent);opacity:.4}.connector.branch span:before{left:16.7%}.connector.branch span:after{right:16.7%}
.flow-label{position:absolute;z-index:4;font-size:.55rem;letter-spacing:.1em;opacity:.45;background:var(--sl-color-bg);padding:2px 5px;border-radius:4px}.l1{top:151px;left:calc(50% + 12px)}.l2{top:285px;left:calc(50% + 12px)}.l3{top:386px;left:calc(50% + 12px)}@keyframes flowDown{from{top:0}to{top:calc(100% - 7px)}}
.statusbar{display:flex;align-items:center;gap:.55rem;padding:.55rem 1.35rem;border-top:1px solid var(--sl-color-gray-5);font-size:.65rem}.statusbar strong{font-size:.61rem;letter-spacing:.08em}.status-copy{opacity:.55}.fault-mode .connector span,.fault-mode .connector:before,.fault-mode .connector:after{background:#ef4444}.fault-mode .node.core{border-color:#ef4444;box-shadow:0 0 24px color-mix(in srgb,#ef4444 16%,transparent)}.fault-mode .node.core:after{content:'REDUNDANT PATH ACTIVE';display:block;color:#ef4444;font-size:.5rem;margin-top:6px}.fault-mode .dot{background:#ef4444}.fault-dot{background:#ef4444;box-shadow:0 0 0 4px color-mix(in srgb,#ef4444 12%,transparent)}
.inspector{border-top:1px solid var(--sl-color-gray-5);padding:1rem 1.35rem;min-height:88px}.inspector-empty{opacity:.6;font-size:.8rem}.selected-title{display:flex;align-items:center;gap:.5rem}.inspector p{margin:.45rem 0 .7rem;font-size:.8rem}.connect-title{font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;opacity:.5}.chips{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.35rem}.chips span{font-size:.65rem;border:1px solid var(--sl-color-gray-5);border-radius:999px;padding:.23rem .48rem}
@media(max-width:700px){.va-head{flex-direction:column;align-items:flex-start}.canvas{min-height:760px;padding:35px 12px 25px}.architecture-row.triple{flex-direction:column;align-items:center;gap:12px}.architecture-row.triple .node{width:min(360px,100%);max-width:none}.architecture-row.bottom{flex-direction:column;align-items:center;gap:12px}.architecture-row.bottom .node{width:min(360px,100%)}.connector.branch{display:none}.flow-label{display:none}.controls{width:100%}}
</style>
