---
const nodes = [
  { id: 'autonomy', title: 'Autonomy Compute', sub: 'Perception • Prediction • Planning', cls: 'ai' },
  { id: 'motion', title: 'Motion Domain', sub: 'Dual-redundant safety-oriented control', cls: 'core' },
  { id: 'steer', title: 'Steering-by-Wire', sub: 'Lateral actuation + feedback', cls: 'act' },
  { id: 'brake', title: 'Brake-by-Wire', sub: 'E/H + regenerative blend', cls: 'act' },
  { id: 'drive', title: '4-Wheel Propulsion', sub: '4 inverters • motors • resolvers', cls: 'act' },
  { id: 'power', title: 'HV / LV Power', sub: 'Battery • BMS • 12V / 48V', cls: 'power' },
  { id: 'network', title: 'Vehicle Network', sub: 'Ethernet • CAN-FD • Gateway', cls: 'net' },
];
---

<div class="va" data-architecture>
  <div class="va-head">
    <div><span class="eyebrow">LIVE VEHICLE MODEL</span><h3>Drive-by-Wire Execution Platform</h3><p>Watch motion intent travel through the execution layer into vehicle actuation.</p></div>
    <div class="controls"><button type="button" class="mode active" data-mode="flow">Signal Flow</button><button type="button" class="mode" data-mode="fault">Fault Mode</button><button type="button" class="reset" data-reset>Reset</button></div>
  </div>

  <div class="canvas" role="application" aria-label="Interactive animated Drive-by-Wire architecture">
    <div class="grid-glow"></div>
    <div class="flow-label l1">MOTION INTENT</div><div class="flow-label l2">VALIDATED CONTROL</div><div class="flow-label l3">ACTUATION</div>
    <div class="pulse-line p1"></div><div class="pulse-line p2"></div><div class="pulse-line p3"></div><div class="pulse-line p4"></div><div class="pulse-line p5"></div>
    <div class="node-grid">
      {nodes.map((node) => (<button type="button" class={`node ${node.cls}`} data-node={node.id}><span class="node-top"><span class="dot"></span><span class="tag">{node.cls === 'core' ? 'EXECUTION' : node.cls.toUpperCase()}</span></span><strong>{node.title}</strong><small>{node.sub}</small></button>))}
    </div>
  </div>

  <div class="statusbar"><span class="live-dot"></span><strong data-status>LIVE SIGNAL PATH</strong><span class="status-copy" data-status-copy>Autonomy → Motion Domain → vehicle actuation</span></div>
  <aside class="inspector" data-inspector aria-live="polite"><div class="inspector-empty">Click a subsystem to inspect it. Try <strong>Fault Mode</strong> to see degraded operation.</div></aside>

  <script is:inline>
    const root = document.querySelector('[data-architecture]');
    if (root) {
      const info = {
        autonomy: ['Autonomy Compute', 'Produces high-level motion intent from perception, prediction and planning. It remains separated from direct safety-critical actuator control.', ['Motion Domain']],
        motion: ['Motion Domain', 'Deterministic execution layer for command validation, arbitration, real-time control and fault handling.', ['Autonomy Compute','Steering-by-Wire','Brake-by-Wire','4-Wheel Propulsion','HV / LV Power','Vehicle Network']],
        steer: ['Steering-by-Wire', 'Safety-critical lateral actuation with redundant sensing, actuator monitoring and defined degraded modes.', ['Motion Domain']],
        brake: ['Brake-by-Wire', 'Coordinates electro-hydraulic friction braking and regenerative braking while respecting wheel, battery and thermal constraints.', ['Motion Domain']],
        drive: ['4-Wheel Propulsion', 'Four independently controlled inverter/motor paths with rotor-position feedback for precise torque execution.', ['Motion Domain']],
        power: ['HV / LV Power', 'HV battery and BMS provide propulsion energy while independent low-voltage paths support vehicle control and redundancy.', ['Motion Domain']],
        network: ['Vehicle Network', 'Automotive Ethernet and CAN-FD provide communication paths with gateway/zonal isolation.', ['Motion Domain']],
      };
      const nodes = [...root.querySelectorAll('[data-node]')], panel = root.querySelector('[data-inspector]'), status = root.querySelector('[data-status]'), statusCopy = root.querySelector('[data-status-copy]'), modes = [...root.querySelectorAll('[data-mode]')];
      function select(id) { const item=info[id]; nodes.forEach(n=>{n.classList.toggle('selected',n.dataset.node===id);n.classList.toggle('dim',n.dataset.node!==id);}); panel.innerHTML=`<div class="selected-title"><span class="status"></span><strong>${item[0]}</strong></div><p>${item[1]}</p><div class="connect-title">CONNECTED TO</div><div class="chips">${item[2].map(x=>`<span>${x}</span>`).join('')}</div>`; }
      nodes.forEach(n=>n.addEventListener('click',()=>select(n.dataset.node)));
      modes.forEach(m=>m.addEventListener('click',()=>{modes.forEach(x=>x.classList.remove('active'));m.classList.add('active');root.classList.toggle('fault-mode',m.dataset.mode==='fault');if(m.dataset.mode==='fault'){status.textContent='FAULT INJECTION: ECU-A OFFLINE';statusCopy.textContent='Redundancy path active • vehicle remains controllable';panel.innerHTML='<div class="selected-title"><span class="fault-dot"></span><strong>Degraded Operation</strong></div><p>One motion-control path is unavailable. The redundant execution path remains active and the system transitions to a reduced-capability state.</p><div class="chips"><span>Fault detected</span><span>Redundant path active</span><span>Reduced redundancy</span></div>';}else{status.textContent='LIVE SIGNAL PATH';statusCopy.textContent='Autonomy → Motion Domain → vehicle actuation';panel.innerHTML='<div class="inspector-empty">Click a subsystem to inspect it. Try <strong>Fault Mode</strong> to see degraded operation.</div>';nodes.forEach(n=>n.classList.remove('selected','dim'));}}));
      root.querySelector('[data-reset]').addEventListener('click',()=>modes[0].click());
    }
  </script>
</div>

<style>
.va{--accent:#10b981;--blue:#3b82f6;--purple:#8b5cf6;--amber:#f59e0b;border:1px solid var(--sl-color-gray-5);border-radius:18px;overflow:hidden;margin:2rem 0;background:var(--sl-color-bg);box-shadow:0 14px 40px color-mix(in srgb,var(--sl-color-black) 10%,transparent)}
.va-head{padding:1.2rem 1.35rem;display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid var(--sl-color-gray-5)}.eyebrow{font-size:.62rem;letter-spacing:.14em;font-weight:800;opacity:.6}.va h3{margin:.25rem 0;font-size:1.2rem}.va-head p{margin:0;font-size:.82rem;opacity:.7}.controls{display:flex;gap:.35rem;flex-wrap:wrap}.mode,.reset{font:inherit;font-size:.68rem;padding:.42rem .6rem;border:1px solid var(--sl-color-gray-5);background:transparent;color:inherit;border-radius:7px;cursor:pointer}.mode.active{background:var(--sl-color-gray-6);font-weight:700}
.canvas{position:relative;min-height:510px;padding:72px 22px 30px;overflow:hidden;background:radial-gradient(circle at 50% 20%,color-mix(in srgb,var(--accent) 7%,transparent),transparent 42%)}.grid-glow{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(var(--sl-color-gray-5) 1px,transparent 1px),linear-gradient(90deg,var(--sl-color-gray-5) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 90%)}
.node-grid{position:relative;z-index:3;display:grid;grid-template-columns:repeat(3,minmax(150px,1fr));gap:28px 20px;max-width:760px;margin:auto}.node{min-height:88px;text-align:left;border:1px solid var(--sl-color-gray-5);border-radius:13px;padding:12px 14px;background:color-mix(in srgb,var(--sl-color-bg) 94%,transparent);backdrop-filter:blur(8px);color:inherit;cursor:pointer;transition:transform .25s,opacity .3s,box-shadow .25s,border-color .25s}.node:nth-child(1),.node:nth-child(2){grid-column:2}.node:nth-child(3){grid-column:1;grid-row:3}.node:nth-child(4){grid-column:2;grid-row:3}.node:nth-child(5){grid-column:3;grid-row:3}.node:nth-child(6){grid-column:1;grid-row:4}.node:nth-child(7){grid-column:3;grid-row:4}.node.ai{border-color:color-mix(in srgb,var(--blue) 50%,var(--sl-color-gray-5))}.node.core{border:2px solid color-mix(in srgb,var(--accent) 65%,var(--sl-color-gray-5));box-shadow:0 0 28px color-mix(in srgb,var(--accent) 13%,transparent)}.node.act{border-color:color-mix(in srgb,var(--purple) 40%,var(--sl-color-gray-5))}.node.power{border-color:color-mix(in srgb,var(--amber) 45%,var(--sl-color-gray-5))}.node.net{border-color:color-mix(in srgb,#06b6d4 45%,var(--sl-color-gray-5))}.node:hover,.node.selected{transform:translateY(-3px);box-shadow:0 10px 28px color-mix(in srgb,var(--sl-color-black) 14%,transparent)}.node.selected{outline:2px solid color-mix(in srgb,var(--accent) 60%,transparent);outline-offset:2px}.node.dim{opacity:.2}.node-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.dot,.live-dot,.status,.fault-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 12%,transparent)}.tag{font-size:.53rem;letter-spacing:.08em;opacity:.45}.node strong,.node small{display:block}.node strong{font-size:.87rem}.node small{font-size:.68rem;opacity:.62;margin-top:4px;line-height:1.3}
.pulse-line{position:absolute;z-index:2;background:var(--accent);opacity:.5;filter:drop-shadow(0 0 5px var(--accent))}.pulse-line:after{content:"";position:absolute;background:var(--accent);box-shadow:0 0 10px var(--accent);border-radius:50%}.p1{left:50%;top:160px;width:2px;height:62px}.p1:after{width:7px;height:7px;left:-2px;animation:flowV 1.7s linear infinite}.p2{left:50%;top:274px;width:2px;height:34px}.p2:after{width:7px;height:7px;left:-2px;animation:flowV 1.2s linear infinite}.p3,.p4,.p5{top:310px;height:2px;width:16%}.p3{left:18%}.p4{left:42%;width:16%}.p5{right:18%}.p3:after,.p4:after,.p5:after{width:7px;height:7px;top:-2px;animation:flowH 1.5s linear infinite}.p3:after{animation-delay:.1s}.p4:after{animation-delay:.35s}.p5:after{animation-delay:.6s}.flow-label{position:absolute;z-index:4;font-size:.55rem;letter-spacing:.1em;opacity:.45;background:var(--sl-color-bg);padding:2px 5px;border-radius:4px}.l1{top:150px;left:calc(50% + 10px)}.l2{top:260px;left:calc(50% + 10px)}.l3{top:296px;left:calc(50% + 10px)}@keyframes flowV{from{top:0}to{top:calc(100% - 7px)}}@keyframes flowH{from{left:0}to{left:calc(100% - 7px)}}
.statusbar{display:flex;align-items:center;gap:.55rem;padding:.55rem 1.35rem;border-top:1px solid var(--sl-color-gray-5);font-size:.65rem}.statusbar strong{font-size:.61rem;letter-spacing:.08em}.status-copy{opacity:.55}.fault-mode .pulse-line{background:#ef4444;filter:drop-shadow(0 0 5px #ef4444)}.fault-mode .p1,.fault-mode .p2{opacity:.18}.fault-mode .node.core{border-color:#ef4444}.fault-mode .node.core:after{content:'REDUNDANT PATH ACTIVE';display:block;color:#ef4444;font-size:.5rem;margin-top:6px}.fault-dot{background:#ef4444;box-shadow:0 0 0 4px color-mix(in srgb,#ef4444 12%,transparent)}
.inspector{border-top:1px solid var(--sl-color-gray-5);padding:1rem 1.35rem;min-height:88px}.inspector-empty{opacity:.6;font-size:.8rem}.selected-title{display:flex;align-items:center;gap:.5rem}.inspector p{margin:.45rem 0 .7rem;font-size:.8rem}.connect-title{font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;opacity:.5}.chips{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.35rem}.chips span{font-size:.65rem;border:1px solid var(--sl-color-gray-5);border-radius:999px;padding:.23rem .48rem}@media(max-width:650px){.va-head{flex-direction:column;align-items:flex-start}.canvas{min-height:650px;padding:60px 12px 25px}.node-grid{grid-template-columns:1fr;gap:12px}.node,.node:nth-child(n){grid-column:1;grid-row:auto}.pulse-line,.flow-label{display:none}.controls{width:100%}}
</style>
