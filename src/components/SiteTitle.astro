---
import '@fontsource/allura/400.css';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a
	href={siteTitleHref}
	class="site-title signature-title sl-flex"
	aria-label="Abhishek Kumar Dwivedi — Home"
>
	<span translate="no">Abhishek</span>
</a>

<style>
	@layer starlight.core {
		.signature-title {
			align-items: center;
			min-width: 0;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
		}

		.signature-title span {
			position: relative;
			display: inline-block;
			padding: 0 0.16em 0.08em 0.04em;
			font-family: 'Allura', cursive;
			font-size: clamp(1.9rem, 3vw, 2.2rem);
			font-weight: 400;
			line-height: 0.9;
			letter-spacing: 0.01em;
		}

		.signature-title span::after {
			content: '';
			position: absolute;
			left: 0.04em;
			bottom: 0.05em;
			width: 108%;
			height: 1px;
			background: currentColor;
			border-radius: 999px;
			opacity: 0.48;
			transform: rotate(-2deg);
			transform-origin: left center;
		}
	}
</style>
